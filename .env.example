# ============================================================
# 复制本文件为 .env，然后填入自己的密钥
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交
# ============================================================

# Dify：AI 面试对话与追问（https://dify.ai 注册后在「访问 API」页获取）
DIFY_API_URL=
DIFY_API_KEY=
DIFY_WORKFLOW_URL=
DIFY_WORKFLOW_KEY=

# 面试报告生成
REPORT_API_URL=

# 阿里云百炼 DashScope：题库练习的 AI 评分
# 获取地址 https://bailian.console.aliyun.com/?tab=model#/api-key
DASHSCOPE_API_KEY=

# 语音合成（TTS）
TTS_URL=
TTS_MODEL=
TTS_VOICE=

# 管理员账号：首次启动时会用这组账号创建管理员
# 密码要求：至少 8 位，字母和数字都要有，且只能用字母和数字
ADMIN_USERNAME=admin_pro
ADMIN_PASSWORD=