# ============================================================
# 复制本文件为 .env，然后填入自己的密钥
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交
#
# !! 改完 .env 必须【重启后端】才生效 !!
# ============================================================

# Dify：AI 面试对话与追问（https://dify.ai 注册后在「访问 API」页获取）
DIFY_API_URL=
DIFY_API_KEY=
DIFY_WORKFLOW_URL=
DIFY_WORKFLOW_KEY=

# 面试报告生成
REPORT_API_URL=

# 阿里云百炼 DashScope：题库练习的 AI 评分
# 获取地址 https://bailian.console.aliyun.com/?tab=model#/api-key
DASHSCOPE_API_KEY=

# 语音合成（TTS）
TTS_URL=
TTS_MODEL=
TTS_VOICE=

# ============================================================
# 管理员账号  ★ 最容易踩坑的地方 ★
# ============================================================
# 后端首次启动时会用这组账号【自动创建】管理员。
# 如果 ADMIN_PASSWORD 留空，后端会跳过创建，后台就永远登录不进去
# （启动日志里会打印「已跳过管理员账号引导（管理后台将无法登录）」）。
#
# 密码要求：至少 8 位，必须同时包含【字母和数字】，且只能由字母和数字组成
# 下面给的是一个可用的默认值，请改成你自己的
ADMIN_USERNAME=admin_pro
ADMIN_PASSWORD=Admin2026pass

# 注意：管理员只在 users.json 不存在该账号时创建一次。
# 之后改 .env 里的密码【不会】覆盖已有账号 —— 需要删掉 users.json 里
# admin_pro 这一条再重启，或者用后台的「重置密码」功能。